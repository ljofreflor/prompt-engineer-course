---
import { getTeacherAuthConfig, sha256Hex } from "../lib/teacher-auth";

const base = import.meta.env.BASE_URL;
const { user, password } = getTeacherAuthConfig();
const expected = await sha256Hex(`${user}:${password}`);
---
<div id="tg-app" data-expected={expected} hidden>
  <slot />
</div>
<div id="tg-login" class="section">
  <div class="container">
    <div class="login-panel">
      <h1 style="margin-top:0;font-size:1.35rem">Se requiere sesión profesor</h1>
      <p style="color:var(--uai-text-muted);font-size:0.92rem">
        <a href={`${base}profesor/`}>Iniciar sesión</a> para ver guiones y soluciones.
      </p>
    </div>
  </div>
</div>
<script>
  const KEY = "uai-teacher-auth";
  const app = document.getElementById("tg-app");
  const login = document.getElementById("tg-login");
  const expected = app?.dataset.expected || "";
  const ok = sessionStorage.getItem(KEY) === expected;
  if (app && login) {
    app.hidden = !ok;
    login.hidden = ok;
  }
</script>
