---
interface Props {
  current?: string;
}

const { current } = Astro.props;
const base = import.meta.env.BASE_URL;

const links = [
  { href: base, id: "home", label: "Inicio" },
  { href: `${base}cursos/`, id: "cursos", label: "Cursos" },
  { href: `${base}herramientas/`, id: "herramientas", label: "Herramientas" },
  { href: `${base}bibliografia/`, id: "bibliografia", label: "Bibliografía" },
  { href: `${base}profesor/`, id: "profesor", label: "Profesor" },
];
---
<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href={base}>
      <img src={`${base}brand/uai-logo-web.png`} alt="Universidad Adolfo Ibáñez" width="160" height="33" />
      <span class="brand__text">
        <span class="brand__kicker">Magíster en IA</span>
        <span class="brand__name">Material de cursos</span>
      </span>
    </a>
    <nav class="nav" aria-label="Principal">
      {
        links.map((l) => (
          <a href={l.href} aria-current={current === l.id ? "page" : undefined}>
            {l.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
