---
import { asset } from "../lib/base";
import { primaryNav } from "../data/sitemap";

interface Props {
  current?: string;
}

const { current } = Astro.props;
const home = asset("");

const links = primaryNav().map((n) => ({
  href: n.path === "" ? home : asset(n.path),
  id: n.id,
  label: n.label,
}));
---
<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href={home} aria-label="Universidad Adolfo Ibáñez — Magíster en IA">
      <img
        class="brand__logo"
        src={asset("brand/uai-logo-web.png")}
        alt="UAI — Universidad Adolfo Ibáñez"
        width="160"
        height="33"
      />
    </a>
    <nav class="nav" aria-label="Principal">
      {
        links.map((l) => (
          <a href={l.href} aria-current={current === l.id ? "page" : undefined}>
            {l.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
