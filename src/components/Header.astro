---
import { asset } from "../lib/base";

interface Props {
  current?: string;
}

const { current } = Astro.props;
const home = asset("");

const links = [
  { href: home, id: "home", label: "Inicio" },
  { href: asset("cursos/"), id: "cursos", label: "Cursos" },
  { href: asset("clases/"), id: "clases", label: "Clases" },
  { href: asset("herramientas/"), id: "herramientas", label: "Herramientas" },
  { href: asset("bibliografia/"), id: "bibliografia", label: "Bibliografía" },
  { href: asset("profesor/"), id: "profesor", label: "Profesor" },
];
---
<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href={home} aria-label="Universidad Adolfo Ibáñez — Magíster en IA">
      <img
        class="brand__logo"
        src={asset("brand/uai-logo-web.png")}
        alt="UAI — Universidad Adolfo Ibáñez"
        width="160"
        height="33"
      />
    </a>
    <nav class="nav" aria-label="Principal">
      {
        links.map((l) => (
          <a href={l.href} aria-current={current === l.id ? "page" : undefined}>
            {l.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
