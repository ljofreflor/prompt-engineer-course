---
const base = import.meta.env.BASE_URL;
---
<footer class="site-footer">
  <div class="container site-footer__inner">
    <img
      src={`${base}brand/uai-logo.svg`}
      alt="Universidad Adolfo Ibáñez"
      width="120"
      height="34"
      style="filter:brightness(0) invert(1); height:28px; width:auto; margin-bottom:0.5rem"
    />
    <strong>Universidad Adolfo Ibáñez</strong>
    <span>Magíster en Inteligencia Artificial — Facultad de Ingeniería y Ciencias</span>
    <span>
      Material de apoyo al dictado (no es el sitio oficial).
      <a href="https://www.uai.cl/postgrados/magisteres/magister-en-inteligencia-artificial">Ficha del programa</a>
      ·
      <a href={`${base}profesor/`}>Vista profesor</a>
    </span>
  </div>
</footer>
