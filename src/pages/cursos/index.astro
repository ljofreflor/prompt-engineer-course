---
import StudentLayout from "../../layouts/StudentLayout.astro";
import { courses } from "../../data/courses";

const base = import.meta.env.BASE_URL;
---
<StudentLayout title="Cursos — Magíster en IA UAI" current="cursos">
  <section class="section">
    <div class="container">
      <div class="section__head">
        <h1>Cursos</h1>
        <p>Cuatro asignaturas del Magíster / Diplomado en IA — Universidad Adolfo Ibáñez.</p>
      </div>
      <div class="grid-courses">
        {
          courses.map((c) => (
            <a class="course-card" href={`${base}cursos/${c.slug}/`}>
              <span class="course-card__code">Curso {c.code}</span>
              <h3>{c.title}</h3>
              <p>{c.short}</p>
              <span class="course-card__meta">{c.hours} hrs · {c.units.length} unidades</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</StudentLayout>
