---
import { courses, getCourse } from "../../../../../data/courses";
import { getProgram } from "../../../../../data/programs";
import { slidesFromUnit, type Slide } from "../../../../../lib/slides";
import { getSlideOverride } from "../../../../../content/slides";
import { asset } from "../../../../../lib/base";

export function getStaticPaths() {
  return courses.flatMap((c) =>
    c.units.map((u) => ({
      params: { slug: c.slug, unit: u.id },
    })),
  );
}

const course = getCourse(Astro.params.slug!);
if (!course) throw new Error("curso");
const program = getProgram(course.slug);
const unit = program?.unidades.find((u) => u.id === Astro.params.unit);
if (!program || !unit) throw new Error("unidad");

const slides: Slide[] =
  getSlideOverride(course.slug, unit.id) ?? slidesFromUnit(course, program, unit);

const fonts = {
  corp300: asset("fonts/uai-corp-300.otf"),
  corp800: asset("fonts/uai-corp-800.otf"),
  roboto400: asset("fonts/roboto-400.ttf"),
  roboto800: asset("fonts/roboto-900.ttf"),
};

const logo = asset("brand/uai-logo-web.png");
const chromeMeta = `Curso ${course.code} · Unidad ${unit.number}`;
const exitHref = asset(`cursos/${course.slug}/${unit.id}/`);

function sectionParts(s: Extract<Slide, { type: "section" }>) {
  const raw = s.subtitle?.trim() || "";
  const time = raw.match(/^(\d+\s*min)/i)?.[1];
  const topic = raw.replace(/^\d+\s*min\s*[—–-]\s*/i, "").trim() || s.title;
  const kicker = time ? `${s.title} · ${time}` : s.title;
  return { kicker, topic, timeLabel: raw && raw !== topic ? raw : undefined };
}
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{`Clase · ${unit.title} · Curso ${course.code} UAI`}</title>
    <link rel="stylesheet" href={asset("vendor/reveal/reveal.css")} />
    <link rel="stylesheet" href={asset("styles/reveal-uai.css")} />
    <style is:global define:vars={fonts}>
      @font-face {
        font-family: "UAI Corporativo";
        src: url(var(--corp300)) format("opentype");
        font-weight: 300;
        font-display: swap;
      }
      @font-face {
        font-family: "UAI Corporativo";
        src: url(var(--corp800)) format("opentype");
        font-weight: 800;
        font-display: swap;
      }
      @font-face {
        font-family: "Roboto";
        src: url(var(--roboto400)) format("truetype");
        font-weight: 400;
        font-display: swap;
      }
      @font-face {
        font-family: "Roboto";
        src: url(var(--roboto800)) format("truetype");
        font-weight: 800;
        font-display: swap;
      }
    </style>
  </head>
  <body>
    <header class="slide-topbar">
      <div class="slide-topbar__brand">
        <img class="slide-topbar__logo" src={logo} alt="UAI" />
        <span class="slide-topbar__program">Magíster en Inteligencia Artificial</span>
      </div>
      <a class="slide-topbar__exit" href={exitHref}>Salir de la clase</a>
    </header>
    <div class="slide-chrome" aria-hidden="true">
      <span class="slide-chrome__accent"></span>
      <span class="slide-chrome__meta"><strong>{chromeMeta}</strong> · {unit.title}</span>
      <span class="slide-chrome__meta">Universidad Adolfo Ibáñez</span>
    </div>
    <div class="reveal">
      <div class="slides">
        {
          slides.map((s) => {
            if (s.type === "title") {
              return (
                <section class="slide-title" data-background-color="#ffffff">
                  <p class="uai-kicker">{s.kicker}</p>
                  <hr class="title-rule" />
                  <h1>{s.title}</h1>
                  {s.subtitle && <p class="uai-muted">{s.subtitle}</p>}
                </section>
              );
            }
            if (s.type === "section") {
              const parts = sectionParts(s);
              return (
                <section class="slide-section" data-background-color="#f3f5f7">
                  <p class="uai-kicker">{parts.kicker}</p>
                  <h2>{parts.topic}</h2>
                  {parts.timeLabel && <p class="uai-muted">{parts.timeLabel}</p>}
                </section>
              );
            }
            if (s.type === "bullets") {
              return (
                <section class="slide-content" data-background-color="#ffffff">
                  {s.kicker && <p class="uai-kicker">{s.kicker}</p>}
                  <h2>{s.title}</h2>
                  <ul>
                    {s.items.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </section>
              );
            }
            if (s.type === "image") {
              return (
                <section class="slide-content" data-background-color="#ffffff">
                  {s.kicker && <p class="uai-kicker">{s.kicker}</p>}
                  <h2>{s.title}</h2>
                  <img class="slide-shot" src={asset(s.src)} alt={s.alt} />
                  {s.caption && <p class="uai-muted slide-caption">{s.caption}</p>}
                </section>
              );
            }
            return (
              <section class="slide-content" data-background-color="#ffffff">
                {s.kicker && <p class="uai-kicker">{s.kicker}</p>}
                <h2>{s.title}</h2>
                {s.paragraphs.map((p) => (
                  <p>{p}</p>
                ))}
              </section>
            );
          })
        }
      </div>
    </div>
    <script is:inline src={asset("vendor/reveal/reveal.js")}></script>
    <script is:inline>
      (function bootReveal() {
        function start() {
          if (!window.Reveal || typeof window.Reveal.initialize !== "function") {
            console.error("Reveal.js no cargó (window.Reveal ausente).");
            return;
          }
          window.Reveal.initialize({
            hash: true,
            slideNumber: "c/t",
            controls: true,
            progress: true,
            center: false,
            transition: "fade",
            backgroundTransition: "fade",
            width: 1280,
            height: 720,
            margin: 0.04,
          }).catch(function (err) {
            console.error("Reveal.initialize falló", err);
          });
        }
        if (document.readyState === "complete") start();
        else window.addEventListener("load", start);
      })();
    </script>
  </body>
</html>
