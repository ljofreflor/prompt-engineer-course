---
import StudentLayout from "../layouts/StudentLayout.astro";
import { courses } from "../data/courses";
import { asset } from "../lib/base";
---
<StudentLayout title="Magíster en Inteligencia Artificial — UAI" current="home">
  <section class="hero">
    <img class="hero__media" src={asset("brand/mia-hero.jpg")} alt="" />
    <div class="hero__scrim"></div>
    <div class="container hero__content">
      <h1>
        <span class="w-heavy">Magíster en</span><br />
        Inteligencia Artificial
      </h1>
      <p>
        Formamos especialistas capaces de automatizar tareas complejas a través del desarrollo,
        diseño y evaluación de sistemas. Material de los cursos GenAI, Prompt Engineering,
        Diseño de Sistemas y AI.Ops.
      </p>
      <div class="hero__actions">
        <a class="btn btn--primary" href={asset("cursos/")}>Cursos</a>
        <a class="btn btn--primary" href={asset("herramientas/")}>Herramientas</a>
        <a class="btn btn--ghost" href={asset("profesor/")}>Acceso profesor</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section__head">
        <span class="section__eyebrow">Conoce nuestros</span>
        <h2>Cursos</h2>
        <p>
          Arco técnico de la malla 2026 (cursos 08–11). Vista alumno pública;
          la vista profesor requiere credenciales.
        </p>
      </div>

      <div class="tabs" role="tablist" aria-label="Vista">
        <span class="is-active">Material de estudio</span>
        <a href={asset("profesor/")}>Vista profesor</a>
      </div>

      <div class="info-grid" style="margin-bottom: 1.75rem">
        <div class="info-card">
          <h4 class="label-uai">Modalidad</h4>
          <p style="margin:0.5rem 0 0;color:var(--uai-gray)">Online / híbrida · stack por curso (local, APIs, nubes académicas)</p>
        </div>
        <div class="info-card">
          <h4 class="label-uai">Carga</h4>
          <p style="margin:0.5rem 0 0;color:var(--uai-gray)">24–28 hrs lectivas por asignatura · 4 créditos</p>
        </div>
        <div class="info-card info-card--destacado">
          <h4 class="label-uai">Destacado</h4>
          <p style="margin:0.5rem 0 0">Curso 09 Prompt Engineering con labs ejecutables y bibliografía OA descargada.</p>
        </div>
      </div>

      <div class="grid-courses">
        {
          courses.map((c) => (
            <a class="course-card" href={asset(`cursos/${c.slug}/`)}>
              <span class="course-card__code">Curso {c.code}</span>
              <h3>{c.title}</h3>
              <p>{c.short}</p>
              <span class="course-card__meta">
                {c.hours} hrs lectivas · {c.credits} créditos · {c.status === "ready" ? "contenido listo" : "esqueleto"}
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</StudentLayout>
