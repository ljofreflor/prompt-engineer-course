---
import StudentLayout from "../../layouts/StudentLayout.astro";
import { courses } from "../../data/courses";
import { getTeacherAuthConfig, sha256Hex } from "../../lib/teacher-auth";

const base = import.meta.env.BASE_URL;
const { user, password } = getTeacherAuthConfig();
const expected = await sha256Hex(`${user}:${password}`);
---
<StudentLayout title="Vista profesor — UAI" current="profesor">
  <section class="section" id="teacher-root" data-expected={expected} data-user={user} hidden>
    <div class="container">
      <div class="section__head">
        <span class="badge">Solo docentes</span>
        <h1>Vista profesor</h1>
        <p>Guiones de sesión, claves de taller y notas de contingencia. No compartir con el curso.</p>
      </div>
      <div class="grid-courses">
        {
          courses.map((c) => (
            <a class="course-card" href={`${base}profesor/cursos/${c.slug}/`}>
              <span class="course-card__code">Curso {c.code}</span>
              <h3>{c.title}</h3>
              <p>Material docente · {c.units.length} unidades</p>
            </a>
          ))
        }
      </div>
      <p style="margin-top:1.5rem">
        <button class="btn btn--ghost" type="button" id="logout-btn">Cerrar sesión profesor</button>
      </p>
    </div>
  </section>

  <section class="section" id="login-root">
    <div class="container">
      <form class="login-panel" id="teacher-login">
        <h1 style="margin-top:0;font-size:1.4rem">Acceso profesor</h1>
        <p style="color:var(--uai-text-muted);font-size:0.92rem">
          Control pedagógico (sitio estático). No es autenticación empresarial.
        </p>
        <div class="error" id="login-error" hidden></div>
        <label for="user">Usuario</label>
        <input id="user" name="user" autocomplete="username" required />
        <label for="password">Contraseña</label>
        <input id="password" name="password" type="password" autocomplete="current-password" required />
        <button class="btn btn--primary" type="submit" style="width:100%">Entrar</button>
      </form>
    </div>
  </section>
</StudentLayout>

<script>
  const KEY = "uai-teacher-auth";
  const root = document.getElementById("teacher-root");
  const loginRoot = document.getElementById("login-root");
  const form = document.getElementById("teacher-login") as HTMLFormElement | null;
  const err = document.getElementById("login-error");
  const expected = root?.dataset.expected || "";

  async function sha256Hex(value: string) {
    const data = new TextEncoder().encode(value);
    const digest = await crypto.subtle.digest("SHA-256", data);
    return [...new Uint8Array(digest)].map((b) => b.toString(16).padStart(2, "0")).join("");
  }

  function showApp(ok: boolean) {
    if (!root || !loginRoot) return;
    root.hidden = !ok;
    loginRoot.hidden = ok;
  }

  showApp(sessionStorage.getItem(KEY) === expected);

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    const user = String(fd.get("user") || "").trim();
    const password = String(fd.get("password") || "");
    const hash = await sha256Hex(`${user}:${password}`);
    if (hash === expected) {
      sessionStorage.setItem(KEY, hash);
      showApp(true);
    } else if (err) {
      err.hidden = false;
      err.textContent = "Usuario o contraseña incorrectos.";
    }
  });

  document.getElementById("logout-btn")?.addEventListener("click", () => {
    sessionStorage.removeItem(KEY);
    showApp(false);
  });
</script>
