---
import StudentLayout from "../../../../layouts/StudentLayout.astro";
import TeacherGate from "../../../../components/TeacherGate.astro";
import { courses, getCourse } from "../../../../data/courses";

export function getStaticPaths() {
  return courses.map((c) => ({ params: { slug: c.slug } }));
}

const course = getCourse(Astro.params.slug!);
if (!course) throw new Error("curso");
const base = import.meta.env.BASE_URL;
---
<StudentLayout title={`Profesor · ${course.title}`} current="profesor">
  <TeacherGate>
    <section class="section">
      <div class="container prose">
        <span class="badge">Docente · Curso {course.code}</span>
        <h1>{course.title}</h1>
        <p>
          Guiones por unidad (4 bloques × 60 min). No proyectar esta página en clase sin
          ocultar soluciones de talleres.
        </p>
        <ul class="unit-list">
          {
            course.units.map((u) => (
              <li>
                <a href={`${base}profesor/cursos/${course.slug}/${u.id}/`}>
                  <strong>
                    Guion {u.id.toUpperCase()} · {u.title}
                  </strong>
                  <span>{u.hours} hrs</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </TeacherGate>
</StudentLayout>
