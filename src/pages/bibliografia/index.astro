---
import StudentLayout from "../../layouts/StudentLayout.astro";
import papers from "../../../references/papers_config.json";

const base = import.meta.env.BASE_URL;
const entries = Object.entries(papers).map(([key, meta]) => ({
  key,
  ...(meta as { title: string; eprint: string; url: string }),
}));
---
<StudentLayout title="Bibliografía — Magíster IA UAI" current="bibliografia">
  <section class="section">
    <div class="container prose">
      <h1>Bibliografía</h1>
      <p>
        Papers open-access descargados en <code>references/papers/&lt;key&gt;/</code>
        (no versionados en git). Config: <code>references/papers_config.json</code>.
      </p>
      <p class="note">{entries.length} PDFs locales disponibles vía arXiv.</p>

      <h2>Catálogo local</h2>
      <ul>
        {
          entries.map((e) => (
            <li>
              <strong>{e.key}</strong> — {e.title}
              {" · "}
              <a href={e.url}>arXiv:{e.eprint}</a>
            </li>
          ))
        }
      </ul>

      <h2>Por curso (syllabi)</h2>
      <h3>09 Prompt Engineering — obligatoria</h3>
      <ul>
        <li>brown2020fewshot, greshake2023injection, kapoor2024agents, schulhoff2024prompt, wei2022cot, yao2023react, zheng2023judge</li>
      </ul>
      <h3>08 GenAI / LLMs — selección</h3>
      <ul>
        <li>vaswani2017attention, brown2020fewshot, ouyang2022instruct, hu2022lora, lewis2020rag, bommasani2021foundation, dettmers2023qlora, liu2024lostmiddle, rafailov2023dpo, zheng2023judge</li>
      </ul>

      <p>
        Labs: <a href={`${base}herramientas/`}>herramientas locales</a>.
      </p>
    </div>
  </section>
</StudentLayout>
