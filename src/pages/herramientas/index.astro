---
import StudentLayout from "../../layouts/StudentLayout.astro";
import { asset } from "../../lib/base";
import { courseStacks, sharedLocalTools } from "../../data/stack";

const shots = [
  {
    src: "labs/screenshots/lmstudio-server-status.png",
    alt: "Estado del servidor LM Studio en puerto 1234",
    caption: "lms ps · gemma-4-e4b · API /v1/models",
  },
  {
    src: "labs/screenshots/lab-u01-lmstudio-result.png",
    alt: "Resultado del lab 09/u01 contra LM Studio",
    caption: "Lab 09/u01 · score 4/4 · abstención OOD",
  },
];
---
<StudentLayout title="Herramientas y stack — UAI" current="herramientas">
  <section class="section">
    <div class="container prose">
      <h1>Herramientas y stack tecnológico</h1>
      <p>
        El stack concreto implementa lo que cada syllabus llama
        <em>Requisitos técnicos y plataforma</em>: cuadernos y APIs (08–09),
        diagramación y repo (10), nubes + contenedores + CI (11), con
        <strong>contingencia local</strong> (LM Studio / Ollama) cuando cae el proveedor.
      </p>
      <div class="note">
        Datos: solo públicos o sintéticos. Sin PII ni secretos de producción en terceros.
        Claves por equipo, crédito prepagado; el estudiante no factura.
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container prose">
      <h2>Base local (todos los cursos)</h2>
      <ul class="stack-list">
        {
          sharedLocalTools.map((t) => (
            <li>
              {t.href ? (
                <a href={t.href} target="_blank" rel="noreferrer">
                  <strong>{t.name}</strong>
                </a>
              ) : (
                <strong>{t.name}</strong>
              )}
              — {t.role}
              {t.setup && (
                <>
                  {" "}
                  <code>{t.setup}</code>
                </>
              )}
            </li>
          ))
        }
      </ul>

      <h3>Arranque rápido LM Studio</h3>
      <pre><code>export OPENAI_BASE_URL=http://localhost:1234/v1
export OPENAI_API_KEY=lm-studio
export OPENAI_MODEL=google/gemma-4-e4b
make smoke          # o: python3 labs/smoke_local.py
make lab-09-u02     # regresión + rúbrica → labs/09/runs/
make labs-09        # u01→u04 en serie
python3 labs/11/u01/health_wrapper.py</code></pre>
      <p class="note">Makefile en la raíz del repo: un comando por lab (market #4 · cero fricción).</p>

      <h3>Evidencia de corrida</h3>
      <div class="lab-gallery">
        {
          shots.map((s) => (
            <figure class="lab-shot">
              <img src={asset(s.src)} alt={s.alt} loading="lazy" />
              <figcaption>{s.caption}</figcaption>
            </figure>
          ))
        }
      </div>
      <ul class="stack-list">
        <li>
          <a href={asset("labs/runs/lab-11-u01-health.json")}
            ><strong>11/u01 health</strong></a
          >
          — LM Studio · gemma-4-e4b · /health JSON
        </li>
        <li>
          <a href={asset("labs/runs/u01-structured-lmstudio-gemma4-tick5.txt")}
            ><strong>09/u01 structured</strong></a
          >
          — score 4/4 · abstención OOD
        </li>
        <li>
          <a href={asset("labs/runs/u02-regression-lmstudio-gemma4-tick7.txt")}
            ><strong>09/u02 regression</strong></a
          >
          — score 4/4 · prompt=v1
        </li>
        <li>
          <a href={asset("labs/runs/u03-verify-lmstudio-gemma4-tick8.txt")}
            ><strong>09/u03 verify</strong></a
          >
          — score 3/3 · verificación programática
        </li>
        <li>
          <a href={asset("labs/runs/u04-agent-lmstudio-gemma4-tick9.txt")}
            ><strong>09/u04 agent</strong></a
          >
          — ReAct · file_read → calculator → finish
        </li>
      </ul>
    </div>
  </section>

  {
    courseStacks.map((cs) => (
      <section class="section" id={`curso-${cs.courseCode}`}>
        <div class="container prose">
          <h2>
            Curso {cs.courseCode}{" "}
            <a class="stack-course-link" href={asset(`cursos/${cs.courseSlug}/`)}>
              ver programa
            </a>
          </h2>
          <p>{cs.summary}</p>
          {
            cs.groups.map((g) => (
              <div class="stack-group">
                <h3>{g.title}</h3>
                <p class="stack-ref">Syllabus: {g.syllabusRef}</p>
                <ul class="stack-list">
                  {g.tools.map((t) => (
                    <li>
                      {t.href ? (
                        <a href={t.href} target="_blank" rel="noreferrer">
                          <strong>{t.name}</strong>
                        </a>
                      ) : (
                        <strong>{t.name}</strong>
                      )}
                      — {t.role}
                      {t.setup && (
                        <>
                          {" "}
                          <code>{t.setup}</code>
                        </>
                      )}
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </section>
    ))
  }

  <section class="section section--soft">
    <div class="container prose">
      <h2>Otras piezas opcionales</h2>
      <ul>
        <li>
          <strong>llama.cpp</strong> — inferencia cuantizada en CPU (contingencia 08).
        </li>
        <li>
          <strong>Open WebUI</strong> — chat sobre Ollama/LM Studio para demos.
        </li>
        <li>
          <strong>vLLM / TGI</strong> — serving de alto throughput (contexto curso 11; no obligatorio en labs locales).
        </li>
      </ul>
    </div>
  </section>
</StudentLayout>
